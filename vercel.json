{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview-*": true
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/research/:path*",
      "destination": "/api/automation-paused"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/video/midnight",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/video/transcript-worker",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/video/late-morning",
      "schedule": "0 13 * * *"
    }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; elif printf '%s' \"$VERCEL_GIT_COMMIT_REF\" | grep -Eq '^preview-' && printf '%s' \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -Fq '[preview]'; then exit 1; else exit 0; fi"
}
