# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_UPDATE_TOKEN=
CRON_SECRET=
YOUTUBE_DATA_API_KEY=
TRANSCRIPT_API_KEY=
OPENAI_API_KEY=

# OpenAI market-intelligence runtime. Live Desk is the only reasoning owner.
OPENAI_INTELLIGENCE_ENABLED=true
OPENAI_INTELLIGENCE_MODEL=gpt-5-mini
OPENAI_INTELLIGENCE_FAST_MODEL=gpt-5-mini
OPENAI_INTELLIGENCE_REASONING_EFFORT=medium
OPENAI_INTELLIGENCE_FAST_REASONING_EFFORT=low

# Scheduling is intentionally off while coding. Set true only after CRON_SECRET,
# provider credentials and the two Vercel Cron routes have been verified in production.
NEXT_PUBLIC_RESEARCH_SCHEDULE_ENABLED=false

# Optional self-hosted OpenBB Workspace/API bridge. OpenBB is not a managed runtime endpoint.
OPENBB_API_URL=

# Optional preview-only test authentication; never use this in production.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional channel-ID overrides (handles are resolved when omitted).
YOUTUBE_CHANNEL_ID_FX_EVOLUTION=
YOUTUBE_CHANNEL_ID_KEVIN_GERRITY=
# Canonical ClearValue Tax channel, not its uploads playlist.
YOUTUBE_CHANNEL_ID_CLEARVALUE_TAX=UCigUBIf-zt_DA6xyOQtq2WA
YOUTUBE_CHANNEL_ID_STOCKEDUP=
YOUTUBE_CHANNEL_ID_WALL_STREET_TRUTH_BOMBS=
YOUTUBE_CHANNEL_ID_TRADERNICK=
YOUTUBE_CHANNEL_ID_TRADERS_REALITY=
YOUTUBE_CHANNEL_ID_BEGINNER_TRADING=
YOUTUBE_CHANNEL_ID_EURODOLLAR_UNIVERSITY=
YOUTUBE_CHANNEL_ID_BRAVOS_RESEARCH=
